Bootstrap: docker
From: ubuntu:24.04

%post
    apt-get update && apt-get install -y --no-install-recommends \
        gcc libc6-dev make zstd git ca-certificates && \
    git clone --depth 1 https://github.com/tanyongkiam/cake_lpr /opt/cake_lpr && \
    cd /opt/cake_lpr && \
    grep 'cake_lpr.S$' cake_lpr.sha256 | sha256sum -c - && \
    make cake_lpr && install -m755 cake_lpr /usr/local/bin/cake_lpr && \
    apt-get purge -y git && apt-get autoremove -y && rm -rf /var/lib/apt/lists/*

%environment
    export CAKE=/usr/local/bin/cake_lpr

%runscript
    exec /usr/local/bin/cake_lpr "$@"

%labels
    Purpose "HOL4-verified LRAT/LPR proof checker for the Conway o7 certificate"

%help
    Build:  apptainer build cake_lpr.sif cake_lpr.def
    Check:  apptainer exec cake_lpr.sif cake_lpr F.cnf proof.lrat
    Bulk:   CAKE="apptainer exec cake_lpr.sif cake_lpr" ./cake_verify.sh
